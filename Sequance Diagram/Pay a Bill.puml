@startuml
title Sequence Diagram - Pay a Bill
autonumber

actor Customer
participant "PayLink App" as App
participant "Payment Module" as Payment
participant "Biller Catalog" as BillerCat
participant "Fees Module" as Fees
participant "Fraud Checks" as Fraud
participant "Accounts & Wallet" as Wallet
participant "Biller Integration" as BillerInt
participant "External Biller" as Biller
participant "Notifications" as Notif

== 1. Inquiry & Fee Calculation ==
Customer -> App : Select biller & enter account/meter number
App -> BillerCat : Request bill inquiry
BillerCat -> BillerInt : Fetch bill details
BillerInt -> Biller : Get bill amount
Biller --> BillerInt : Return bill amount
BillerInt --> BillerCat : Bill amount
BillerCat -> Fees : Calculate service fee
Fees --> BillerCat : Service fee
BillerCat --> App : Show bill amount, fee, and total

== 2. Payment & Validation ==
Customer -> App : Confirm payment
App -> Payment : Initiate payment (with Idempotency Key)
note over Payment : State: Initiated

Payment -> Fraud : Run fraud & limit checks
alt Fraud check fails
    Fraud --> Payment : Rejected (limit/velocity/blocked)
    note over Payment : State: Rejected
    Payment --> App : Payment rejected
else Fraud check passes
    Fraud --> Payment : Approved
    Payment -> Wallet : Hold total amount (Bill + Fee)
    
    alt Insufficient balance
        Wallet --> Payment : Insufficient funds
        note over Payment : State: Rejected
        Payment --> App : Payment rejected
    else Balance sufficient
        Wallet --> Payment : Funds held (Ledger updated)
        note over Payment : State: FundsHeld

        == 3. Biller Execution ==
        Payment -> BillerInt : Send payment request
        note over Payment : State: SentToBiller
        BillerInt -> Biller : Pay bill

        alt Biller confirms payment
            Biller --> BillerInt : Confirmed
            BillerInt --> Payment : Payment success
            note over Payment : State: Completed
            Payment -> Wallet : Convert hold to final charge & credit fee/commission
            Payment -> Notif : Send receipt (SMS & Push)
            Payment --> App : Payment successful
        else Biller times out
            Biller --x BillerInt : Timeout (10s)
            BillerInt --> Payment : Timeout
            note over Payment : State: Unknown
            Payment --> App : Payment processing (stays held)
        end
    end
end
@enduml